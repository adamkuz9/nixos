output "eDP-1" {
    mode "2880x1800@120.000"
    scale 1.5
    transform "normal"
    position x=0 y=0
}
output "HDMI-A-1" {
    mode "3840x2160@30.000"
    scale 1.0
    transform "normal"
    position x=-1920 y=0
}
output "DP-1" {
    mode "5120x1440@240"
    scale 1
    transform "normal"
    position x=1920 y=0
}